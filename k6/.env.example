# Target API (replace with the API you want to test)
BASE_URL=http://host.docker.internal:8080
API_PATH=/api/example
HTTP_METHOD=GET
BODY_FILE=
BODY_JSON=
HEADERS_JSON='{"Accept":"application/json"}'
AUTH_HEADER_NAME=Authorization
AUTH_HEADER_VALUE=
EXPECTED_STATUS=200
EXPECT_JSON=true
JSON_TYPE=any
MIN_ITEMS=0
TIMEOUT=30s

# Load shape
TEST_ID=generic-api-example
RATE=1
DURATION=1m
PREALLOCATED_VUS=10
MAX_VUS=50
PAGE_MODE=first
PAGE_FIELD=
PAGE_COUNT=1
FAILURE_RATE=0.01
CHECK_SUCCESS_RATE=0.99
SMOKE=

# Grafana local login (change the password before starting the stack)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
